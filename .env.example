# Copy to .env and adjust. Never commit the real .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-dev-only-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# Inside docker-compose these hostnames are overridden (db, redis).
# From the host machine the compose Postgres is published on port 5433.
DATABASE_URL=postgres://resq:resq@localhost:5433/resq
REDIS_URL=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1

POSTGRES_DB=resq
POSTGRES_USER=resq
POSTGRES_PASSWORD=resq

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000

# Dev only: return the OTP in the API response. Must be false in production.
OTP_DEBUG_RETURN_CODE=true

# SMS provider (console backend logs codes to the backend container output)
SMS_BACKEND=accounts.sms.backends.console.ConsoleSMSBackend
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
SMS_SENDER=4546

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ResQ <noreply@resq.uz>

# Telegram notifications (leave empty to disable the channel)
TELEGRAM_BOT_TOKEN=
